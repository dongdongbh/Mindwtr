  "scripts": {
    "desktop:dev": "bun run --filter mindwtr dev",
    "desktop:web": "bun run --filter mindwtr dev:vite",
    "desktop:build": "bun run --filter mindwtr build",
    "desktop:web:build": "bun run --filter mindwtr build:vite",
    "test": "bun run --filter @mindwtr/core test && bun run --filter mindwtr test && bun run --filter mobile test && bun run --filter mindwtr-cloud test && bun run --filter mindwtr-mcp test",
    "verify": "bun run typecheck && bun run lint:all && bun run test && bun run native:test && bun run test:governance && bun run i18n:check && bun run schema:check && bun run docs:check-readme",
    "test:perf": "bun run --filter @mindwtr/core test:perf && bun --cwd apps/desktop test src/components/views/ListView.performance.test.tsx src/components/views/TimelineView.performance.test.tsx && bun --cwd apps/mobile test tests/large-store-performance.test.tsx",
    "test:governance": "python3 scripts/ci/google-play-edit.test.py && bun test scripts/check-synced-field-parity.test.ts scripts/ci/check-android-16kb-page-size.test.js scripts/ci/validate-publish-repo-workflow.test.js scripts/ci/validate-release-rc-workflow.test.js scripts/ci/validate-release-notes-index.test.js scripts/ci/validate-docker-compose.test.js scripts/ci/validate-aur-package.test.js scripts/ci/update-flathub-checkout.test.js scripts/ci/validate-release-tool-pins.test.js scripts/ci/validate-performance-gate.test.js scripts/ci/validate-native-platform-ci.test.js scripts/ci/validate-dependency-audit.test.js scripts/ci/validate-release-macos-workflow.test.js",
    "lint:core": "bun run --filter @mindwtr/core lint",
    "lint:cloud": "bun run --filter mindwtr-cloud lint",
    "lint:node": "bun run lint:core && bun run lint:cloud",
    "lint:desktop": "bun run --filter mindwtr lint",
    "lint:mobile": "bun run --filter mobile lint",
    "lint:mcp": "bun run --filter mindwtr-mcp lint",
    "lint:all": "bun run lint:node && bun run lint:desktop && bun run lint:mobile && bun run lint:mcp",
    "typecheck": "bun run typecheck:core && bun run typecheck:cloud && bun run typecheck:desktop && bun run typecheck:mobile && bun run typecheck:mcp",
    "typecheck:core": "bun run --filter @mindwtr/core build",
    "typecheck:cloud": "bun run --filter mindwtr-cloud typecheck",
    "typecheck:desktop": "bunx tsc --noEmit -p apps/desktop/tsconfig.json",
    "typecheck:mobile": "bunx tsc --noEmit -p apps/mobile/tsconfig.json",
    "typecheck:mcp": "bun run --filter mindwtr-mcp typecheck",
    "schema:check": "bun run scripts/check-synced-field-parity.ts",
    "native:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "mobile:start": "bun run --filter mobile start",
    "mobile:android": "bun run --filter mobile android",
    "mobile:ios": "bun run --filter mobile ios",
    "mobile:startup:bench": "bash apps/mobile/scripts/android_startup_benchmark.sh",
    "test:e2e": "playwright test",
    "i18n:check": "bun run scripts/i18n-locale-parity.ts --check",
    "docs:check-readme": "bun run scripts/check-readme-heading-parity.ts",
    "mindwtr:cli": "bun run scripts/mindwtr-cli.ts --",
    "mindwtr:api": "bun run scripts/mindwtr-api.ts --",
    "mindwtr:mcp": "bun run --filter mindwtr-mcp dev --",
    "set-version": "bun run scripts/set-version.ts"
  },
