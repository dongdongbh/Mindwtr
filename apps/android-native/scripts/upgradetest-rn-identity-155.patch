+// run-as needs android:debuggable; the build type stays release, so BuildConfig.DEBUG and
+// the embedded Hermes bundle are unchanged. The store-scheme VIEW filter that
+// plugins/android-app-shortcuts.js adds is removed so this app never catches mindwtr:// links.
+// Registered here, before the plugins list, so it runs after every plugin's manifest mod.
+const withUpgradeTestManifest = (config: ExpoConfig): ExpoConfig => withAndroidManifest(config, (mod) => {
+  const application = mod.modResults.manifest.application?.[0];
+  if (!application) throw new Error('[app.config] upgradetest: no <application> in the manifest');
+  application.$['android:debuggable'] = 'true';
+  application.$['tools:ignore'] = 'HardcodedDebugMode';
+  for (const activity of application.activity ?? []) {
+    activity['intent-filter'] = (activity['intent-filter'] ?? []).filter((filter) => (
+      !(filter.data ?? []).some((data) => data.$?.['android:scheme'] === 'mindwtr')
+    ));
+  }
+  return mod;
+});
