+const withUpgradeTestManifest = (config: ExpoConfig): ExpoConfig => withAndroidManifest(config, (mod) => {
+  const application = mod.modResults.manifest.application?.[0];
+  if (!application) throw new Error('[app.config] upgradetest: no <application> in the manifest');
+  application.$['android:debuggable'] = 'true';
