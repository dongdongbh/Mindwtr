<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- An appex must be sandboxed even inside a non-sandboxed host app
         (#1054 decision 8); this is not optional for a WidgetKit extension. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <!-- scripts/build-macos-widget.sh substitutes this with
             "$APPLE_TEAM_ID.tech.dongdongbh.mindwtr" at package time. -->
        <string>__MINDWTR_MACOS_APP_GROUP__</string>
    </array>
</dict>
</plist>
