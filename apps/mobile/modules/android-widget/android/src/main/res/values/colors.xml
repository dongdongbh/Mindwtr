<?xml version="1.0" encoding="utf-8"?>
<!-- Defaults for themeMode "system": the launcher re-inflates widgets on a
     day/night flip, so resource colors follow it without a payload update.
     Same values as widget-data.ts's light palette. -->
<resources>
    <color name="mindwtr_widget_background">#F8FAFC</color>
    <color name="mindwtr_widget_card">#FFFFFF</color>
    <color name="mindwtr_widget_text">#0F172A</color>
    <color name="mindwtr_widget_muted_text">#475569</color>
    <color name="mindwtr_widget_accent">#2563EB</color>
    <color name="mindwtr_widget_border">#CBD5E1</color>
    <color name="mindwtr_widget_warning">#D97706</color>
    <color name="mindwtr_widget_header_wash">#1F2563EB</color>
    <color name="mindwtr_widget_on_accent">#FFFFFF</color>
    <!-- The header's chooser chevron. It rides on the title as a compound
         drawable and RemoteViews refuses setCompoundDrawableTintList, so this
         is the one header colour the payload palette cannot repaint: it has to
         read on the light and the dark surface alike, hence one mid grey with
         no values-night twin. -->
    <color name="mindwtr_widget_chevron_tint">#8A94A6</color>
</resources>
