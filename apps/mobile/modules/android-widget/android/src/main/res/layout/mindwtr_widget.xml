<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks kind: accent header band (date, Inbox chip, "+"), then the Focus
     sections list. Colours default to the day/night resources and are
     overridden at render time from the payload palette (WidgetRenderer). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mindwtr_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/mindwtr_widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/mindwtr_widget_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/mindwtr_widget_header"
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/mindwtr_widget_band"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/mindwtr_widget_band" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <!-- Title + chevron are one tap target: the list chooser. The
                     chevron is the title's own drawableEnd, not a sibling, so
                     it hugs the text at any width and a title too long for the
                     header ellipsizes around it instead of pushing it out of
                     view. The wrapper takes the leftover width so the tap area
                     stays comfortable. Its tint is a fixed mid grey, not a
                     day/night colour: RemoteViews refuses
                     setCompoundDrawableTintList, so this is the one header
                     piece render time cannot repaint from the payload. -->
                <LinearLayout
                    android:id="@+id/mindwtr_widget_title_target"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mindwtr_widget_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/mindwtr_widget_chevron"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/mindwtr_widget_chevron_tint"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/mindwtr_widget_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mindwtr_widget_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:textColor="@color/mindwtr_widget_muted_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mindwtr_widget_capture"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="+"
                    android:textColor="@color/mindwtr_widget_accent"
                    android:textSize="24sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mindwtr_widget_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/mindwtr_widget_border" />

        <ListView
            android:id="@+id/mindwtr_widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/mindwtr_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textColor="@color/mindwtr_widget_muted_text"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
