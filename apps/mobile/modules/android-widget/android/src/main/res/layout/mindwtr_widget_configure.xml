<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mindwtr_widget_configure_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mindwtr_dialog_surface"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- The Background choice shares the title line so the list keeps its
         height in a short window (landscape with the keyboard open). The
         title keeps its width; the choice takes the rest and its long
         option names never push the title out. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mindwtr_widget_configure_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Mindwtr"
            android:textColor="@color/mindwtr_widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/mindwtr_widget_configure_background_row"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mindwtr_widget_configure_background_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/mindwtr_widget_configure_background"
                android:textColor="@color/mindwtr_widget_text" />

            <Spinner
                android:id="@+id/mindwtr_widget_configure_background"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/mindwtr_widget_configure_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:inputType="text"
        android:singleLine="true" />

    <ListView
        android:id="@+id/mindwtr_widget_configure_lists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null" />

    <LinearLayout
        android:id="@+id/mindwtr_widget_configure_grouping_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mindwtr_widget_configure_grouping_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/mindwtr_widget_configure_grouping"
            android:textColor="@color/mindwtr_widget_text" />

        <Spinner
            android:id="@+id/mindwtr_widget_configure_grouping"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mindwtr_widget_configure_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mindwtr_widget_configure_cancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:textColor="@color/mindwtr_widget_accent" />

        <Button
            android:id="@+id/mindwtr_widget_configure_ok"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/mindwtr_dialog_pill"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textAllCaps="false"
            android:textColor="@color/mindwtr_widget_on_accent" />
    </LinearLayout>
</LinearLayout>
