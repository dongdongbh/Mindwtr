{
  "name": "mobile",
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "version": "1.2.8",
  "scripts": {
    "postinstall": "node scripts/patch_query_string_cjs.js",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:dev": "APP_VARIANT=development expo prebuild --clean --platform android && APP_VARIANT=development expo run:android",
    "ios:dev": "APP_VARIANT=development expo prebuild --clean --platform ios && APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "generate:android-monochrome-icon": "node scripts/generate_android_monochrome_icon.js",
    "startup:bench": "bash scripts/android_startup_benchmark.sh",
    "lint": "expo lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@mindwtr/core": "workspace:*",
    "@op-engineering/op-sqlite": "^17.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "date-fns": "^4.1.0",
    "decode-uri-component": "0.5.0",
    "expo": "~54.0.30",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "invariant": "^2.2.4",
    "lucide-react-native": "^0.556.0",
    "nativewind": "^4.2.1",
    "nullthrows": "^1.1.1",
    "query-string": "7.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-alarm-notification": "^1.8.0",
    "react-native-android-widget": "^0.17.2",
    "react-native-draggable-flatlist": "^4.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "0.33.2",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-widgetkit": "^1.0.9",
    "react-native-worklets": "0.5.1",
    "semver": "^7.7.2",
    "tailwindcss": "3.3.2",
    "whatwg-fetch": "^3.6.20",
    "whatwg-url-without-unicode": "^8.0.0-3",
    "whisper.rn": "^0.5.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.25",
    "uuid": "14.0.0",
    "decode-uri-component": "0.5.0",
    "query-string": "7.1.3",
    "browserslist": "4.28.8",
    "postcss-selector-parser": "6.1.4",
    "fast-uri": "3.1.7",
    "@xmldom/xmldom": "0.8.15",
    "@humanfs/node": "0.16.8"
  },
  "op-sqlite": {
    "fts5": true
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-background-task",
          "expo-calendar"
        ]
      }
    },
    "install": {
      "exclude": [
        "@expo/metro-runtime",
        "@expo/vector-icons",
        "expo",
        "expo-asset",
        "expo-constants",
        "expo-file-system",
        "expo-font",
        "expo-linking",
        "expo-router"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fs",
          "@fugood/react-native-audio-pcm-stream",
          "whisper.rn",
          "react-native-widgetkit",
          "react-native-alarm-notification"
        ]
      }
    }
  },
  "private": true
}
