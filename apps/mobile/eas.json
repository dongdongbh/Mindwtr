{
    "cli": {
        "version": ">= 5.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "benchmark": {
            "developmentClient": false,
            "distribution": "internal",
            "android": { "buildType": "apk" },
            "env": {
                "APP_VARIANT": "benchmark",
                "NODE_ENV": "production",
                "EXPO_PUBLIC_STARTUP_PROFILING": "1",
                "ANDROID_PROFILEABLE": "1",
                "ANALYTICS_HEARTBEAT_DISABLED": "1"
            }
        },
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "APP_VARIANT": "development",
                "MINDWTR_WATCH_ENABLED": "true"
            }
        },
        "preview": {
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "ios": {
              "autoIncrement": true
            },
            "distribution": "internal",
            "env": {
                "NODE_ENV": "production",
                "MINDWTR_WATCH_ENABLED": "true"
            }
        },
        "production": {
          "android": {
            "buildType": "app-bundle",
            "credentialsSource": "remote"
          },
          "ios": {                       
            "autoIncrement": true
          }
        },
        "production-apk": {
          "extends": "production",
          "android": { "buildType": "apk" }
        }
    },
    "submit": {
      "production": {}
    }
}
